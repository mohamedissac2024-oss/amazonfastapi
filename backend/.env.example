# ---------------------------------------------------------------
# Backend (FastAPI) - read by config.py via python-dotenv
# ---------------------------------------------------------------
# Required. PostgreSQL connection string.
# Local dev with peer auth (unix socket):
DATABASE_URL=postgresql:///amazonapi?host=/var/run/postgresql
# With a password auth over TCP instead:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/amazon_api
# Required. Long random string used to sign JWT tokens.
SECRET_KEY=change-me-to-a-long-random-secret
# Optional. JWT lifetime in minutes (default 60).
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional. The user registering with this email becomes the admin.
ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------
# Frontend (Vite) - only variables prefixed with VITE_ are exposed
# to the browser.
# ---------------------------------------------------------------
VITE_API_URL=http://localhost:8000
